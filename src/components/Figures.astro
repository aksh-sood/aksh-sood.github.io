---
import { home } from '../data';

const { figures } = home;
---

{/*
  The four measured outcomes. These are real figures from the source resumes,
  so they survive the template rebuild — restyled into the card language the
  rest of the page now uses.
*/}
<section class="figures" id="figures" aria-labelledby="figures-heading">
  <div class="container">
    <h2 id="figures-heading" class="visually-hidden">Measured outcomes</h2>

    <dl class="figures__grid">
      {
        figures.map((figure) => (
          <div class:list={['figure', figure.marked && 'is-marked']}>
            <dt class="figure__value">{figure.value}</dt>
            <dd class="figure__caption">{figure.caption}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .figures {
    padding-bottom: var(--section-gap);
  }

  .figures__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--space-md);
    margin: 0;
  }

  .figure {
    padding: var(--space-lg);
    background: var(--surface);
    border-radius: var(--radius-md);
  }

  /* One figure carries the accent fill — the same single-emphasis budget the
     reference spends on its primary button. */
  .figure.is-marked {
    background: var(--accent);
  }

  .figure__value {
    font-family: var(--face-display);
    font-size: clamp(1.75rem, 3.4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--tracking-display);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .figure.is-marked .figure__value {
    color: var(--accent-ink);
  }

  .figure__caption {
    margin: var(--space-sm) 0 0;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--ink-muted);
  }

  .figure.is-marked .figure__caption {
    color: rgb(20 20 20 / 0.78);
  }
</style>
