---
import type { HTMLAttributes } from 'astro/types';

/*
  Line icons, drawn inline so they inherit currentColor and ship no extra
  request. Decorative by default; pass a `title` when the icon is the only
  label an element has.
*/
interface Props {
  name: 'github' | 'linkedin' | 'mail' | 'arrow' | 'chevron' | 'play';
  title?: string;
  /** Any CSS length. Defaults to 1em so the icon tracks its label. */
  size?: string;
  class?: string;
}

const { name, title, size = '1em', class: className } = Astro.props;

/* Typed explicitly: spreading a bare object widens `role` to string, which is
   narrower than SVGAttributes allows. */
const a11y: HTMLAttributes<'svg'> = title
  ? { role: 'img', 'aria-label': title }
  : { 'aria-hidden': 'true', focusable: 'false' };
---

<svg
  class={className}
  style={`--icon-size:${size}`}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
>
  {name === 'github' && (
    <path
      d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
      fill="none"></path>
  )}

  {name === 'linkedin' && (
    <>
      <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-11h4v1.5A6 6 0 0 1 16 8Z"></path>
      <rect x="2" y="9" width="4" height="12"></rect>
      <circle cx="4" cy="4" r="2"></circle>
    </>
  )}

  {name === 'mail' && (
    <>
      <rect x="2" y="4" width="20" height="16" rx="2"></rect>
      <path d="m22 7-10 6L2 7"></path>
    </>
  )}

  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8"></path>}

  {name === 'chevron' && <path d="m6 9 6 6 6-6"></path>}

  {name === 'play' && <path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor"></path>}
</svg>

<style>
  /*
    Sized here rather than by the caller. A parent's scoped selector does not
    match a child component's root element, so `.talk__arrow { width: … }` in
    Header.astro would leave this svg to fill its flex line.
  */
  svg {
    width: var(--icon-size);
    height: var(--icon-size);
    flex: none;
  }
</style>
