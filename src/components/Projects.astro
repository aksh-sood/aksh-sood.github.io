---
import { getCollection } from 'astro:content';
import Section from './Section.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Section id="projects" label="Projects" eyebrow="Side builds">
  <ol class="projects">
    {
      projects.map(({ data }) => (
        <li class:list={['project', data.featured && 'is-featured']}>
          <div class="project__text">
            <h3 class="project__name">{data.name}</h3>
            <p class="project__tagline">{data.tagline}</p>

            <p class="project__stack">
              {data.stack.map((item) => (
                <span>{item}</span>
              ))}
            </p>

            <p class="project__links">
              {data.demo ? (
                <a href={data.demo}>Live demo</a>
              ) : (
                /* Only the featured build is a deployed app — a "live demo"
                   placeholder on a library or pipeline is a category error,
                   not an open question. */
                data.featured && <span class="todo">[ADD: live demo URL]</span>
              )}
              {data.repo ? (
                <a href={data.repo}>Source</a>
              ) : (
                <span class="todo">[ADD: GitHub URL]</span>
              )}
            </p>
          </div>

          {data.featured && (
            <div class="project__shot">
              <span class="todo">[ADD: screenshot]</span>
            </div>
          )}
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project {
    padding-block: var(--space-xl);
    border-top: var(--hairline) solid var(--rule);
  }

  .project:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .project__name {
    font-size: var(--step-h3);
  }

  .project__tagline {
    max-width: 58ch;
    margin-top: var(--space-xs);
    color: var(--ink-muted);
  }

  /* Stack items read as a list through spacing, not through separators. */
  .project__stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs) var(--space-md);
    margin-top: var(--space-md);
    font-family: var(--face-mono);
    font-size: var(--step-mono-sm);
    letter-spacing: var(--tracking-mono);
    color: var(--ink-muted);
  }

  .project__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
    font-family: var(--face-mono);
    font-size: var(--step-mono-sm);
  }

  /* Placeholders must be obvious without spending the accent, which is
     budgeted at two elements per viewport. */
  .todo {
    color: var(--ink-muted);
    border-bottom: 1px dashed var(--rule-strong);
  }

  /* The featured entry gets the screenshot; everything else is a list row. */
  .project__shot {
    display: grid;
    place-items: center;
    margin-top: var(--space-lg);
    aspect-ratio: 16 / 9;
    border: var(--hairline) dashed var(--rule-strong);
    background: var(--paper-sunk);
    font-family: var(--face-mono);
    font-size: var(--step-mono-sm);
  }

  @media (min-width: 64rem) {
    .project.is-featured {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      gap: var(--space-2xl);
      align-items: start;
    }

    .project.is-featured .project__shot {
      margin-top: 0;
    }
  }
</style>
