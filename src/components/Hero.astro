---
import { home, site } from '../data';
import Icon from './Icon.astro';
import Sparkle from './Sparkle.astro';
import Slot from './Slot.astro';

const { hero } = home;

const socials = [
  { name: 'github' as const, href: site.github, label: 'GitHub' },
  { name: 'linkedin' as const, href: site.linkedin, label: 'LinkedIn' },
  { name: 'mail' as const, href: `mailto:${site.email}`, label: 'Email' },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="container hero__grid">
    {/* Decoration only where there is room beside the copy. */}
    <Sparkle size="1.35rem" top="12%" right="46%" opacity={0.32} wideOnly />
    <Sparkle size="2rem" bottom="4%" left="0" opacity={0.16} wideOnly />

    <div class="hero__copy">
      <p class="hero__available">
        <span class="hero__dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <h1 id="hero-heading" class="hero__name">
        {hero.greeting}{' '}<span class="hero__emoji" role="img" aria-label="waving hand"
          >{hero.emoji}</span
        >{' '}{hero.name}
      </h1>

      {/*
        The first role is rendered server-side and is the whole content without
        script. The cycling is progressive enhancement, and it stays off under
        prefers-reduced-motion.
      */}
      <p class="hero__roles" aria-live="off">
        <span class="hero__role" data-typewriter data-roles={JSON.stringify(hero.roles)}
          >{hero.roles[0]}</span
        ><span class="hero__caret" aria-hidden="true"></span>
      </p>

      <p class="hero__blurb">{hero.blurb}</p>

      <div class="hero__actions">
        <a class="btn" href={hero.cta.href}>{hero.cta.label}</a>

        <ul class="hero__socials">
          {
            socials.map((social) => (
              <li>
                <a class="icon-btn" href={social.href}>
                  <Icon name={social.name} size="1.05rem" title={social.label} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="hero__portrait">
      <div class="panel">
        <Sparkle size="1.1rem" top="0.8rem" right="0.8rem" z={1} />

        {
          hero.portrait ? (
            <img
              class="panel__img"
              src={hero.portrait}
              alt={`${site.name}, ${site.role}`}
              width="520"
              height="620"
            />
          ) : (
            <Slot kind="ADD" tone="panel">
              Portrait photograph. A cut-out or plain-background shot works best against
              the yellow slab — 1200px or more on the short edge.
            </Slot>
          )
        }
      </div>
    </div>
  </div>
</section>

<script>
  const el = document.querySelector<HTMLElement>('[data-typewriter]');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');

  if (el && !reduced.matches) {
    const roles: string[] = JSON.parse(el.dataset.roles ?? '[]');

    if (roles.length > 1) {
      let index = 0;
      let chars = roles[0].length;
      let deleting = true;

      const tick = () => {
        const word = roles[index];
        chars += deleting ? -1 : 1;
        el.textContent = word.slice(0, chars);

        let wait = deleting ? 45 : 85;

        if (!deleting && chars === word.length) {
          deleting = true;
          wait = 1800;
        } else if (deleting && chars === 0) {
          deleting = false;
          index = (index + 1) % roles.length;
          wait = 320;
        }

        setTimeout(tick, wait);
      };

      setTimeout(tick, 2200);
    }
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-2xl) var(--section-gap);
    border-bottom: var(--hairline) solid var(--rule);
  }

  .hero__grid {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }

  /* Copy ---------------------------------------------------------------- */

  .hero__available {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: var(--space-md);
    padding: 0.4rem 0.9rem 0.4rem 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    font-family: var(--face-display);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-muted);
  }

  .hero__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: var(--radius-pill);
    background: var(--accent);
  }

  .hero__name {
    font-size: var(--step-display);
    font-weight: 700;
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-display);
    text-wrap: balance;
  }

  .hero__emoji {
    display: inline-block;
    /* Colour emoji render wide and tall; trimmed and nudged so it sits on the
       cap line rather than pushing the words apart. */
    font-size: 0.74em;
    margin-inline: 0.06em;
    transform: translateY(0.05em);
  }

  .hero__roles {
    display: flex;
    align-items: baseline;
    min-height: 1.3em;
    margin-top: var(--space-xs);
    font-family: var(--face-display);
    font-size: clamp(1.5rem, 3.2vw, 2.25rem);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: var(--tracking-display);
    color: var(--ink-faint);
  }

  .hero__caret {
    width: 2px;
    height: 1em;
    margin-left: 0.12em;
    background: var(--accent);
    animation: blink 1.1s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* Nothing is being typed when the cycling is off, so the caret holds steady
     rather than freezing mid-blink at whatever the global rule lands on. */
  @media (prefers-reduced-motion: reduce) {
    .hero__caret {
      animation: none;
      opacity: 1;
    }
  }

  .hero__blurb {
    max-width: 38rem;
    margin-top: var(--space-lg);
    font-size: var(--step-lead);
    line-height: var(--leading-body);
    color: var(--ink-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
  }

  .hero__socials {
    display: flex;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The yellow slab ----------------------------------------------------- */

  .hero__portrait {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
  }

  .panel {
    --panel-notch: clamp(2.75rem, 11vw, 4.75rem);
    position: relative;
    display: grid;
    place-items: center;
    width: min(100%, 26rem);
    aspect-ratio: 5 / 6;
    padding: var(--space-lg);
    background: var(--panel);
    border-radius: var(--radius-lg);
    border-top-right-radius: 0;
  }

  /*
    The template cuts the panel's top-right corner away. A triangle in the page
    ground does it without fighting border-radius, and the sparkle sits in the
    notch it opens up.
  */
  .panel::after {
    content: '';
    position: absolute;
    top: -1px;
    right: -1px;
    width: var(--panel-notch);
    height: var(--panel-notch);
    background: var(--paper);
    clip-path: polygon(100% 0, 100% 100%, 0 0);
  }


  .panel__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-md);
  }




  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
      gap: var(--space-4xl);
    }

    /* The reference rules a vertical hairline between the two columns. */
    .hero__portrait {
      position: relative;
    }

    .hero__portrait::before {
      content: '';
      position: absolute;
      top: -4rem;
      bottom: -4rem;
      left: calc(var(--space-4xl) / -2);
      border-left: var(--hairline) solid var(--rule);
    }
  }
</style>
